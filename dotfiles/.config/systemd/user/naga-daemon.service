[Unit]
Description=Razer Naga extra buttons (naga-daemon)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/bin/naga-daemon
# Exits when the mouse is missing or disconnects (e.g. Bluetooth), and retries
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
